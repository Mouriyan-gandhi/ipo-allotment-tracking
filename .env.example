# ============================================================================
#  Copy this file to .env and fill in the values. Never commit the real .env.
# ============================================================================

# --- Supabase (or any) Postgres ---------------------------------------------
# From Supabase dashboard: top-bar "Connect" button -> ORMs tab -> Prisma.
# DATABASE_URL = transaction pooler (port 6543), used by the running app.
# DIRECT_URL   = session pooler (port 5432) or direct host, used by migrations.
# If your DB password contains reserved URL chars (# @ / : ? & etc.), URL-encode
# them (e.g. '#' -> '%23'), otherwise auth will silently fail.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Cron protection ---------------------------------------------------------
# The app has no sign-in: every page is public. The one authenticated route is the
# daily scheduled ingestion, /api/cron/sync, which Vercel Cron calls with this as a
# bearer token. Without it, anyone could trigger the scrape on a schedule. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="generate-a-random-string"

# --- Base URL ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
