# ============================================================================
#  Copy this file to .env and fill in the values. Never commit the real .env.
# ============================================================================

# --- Supabase (or any) Postgres ---------------------------------------------
# From Supabase dashboard: top-bar "Connect" button -> ORMs tab -> Prisma.
# DATABASE_URL = transaction pooler (port 6543), used by the running app.
# DIRECT_URL   = session pooler (port 5432) or direct host, used by migrations.
# If your DB password contains reserved URL chars (# @ / : ? & etc.), URL-encode
# them (e.g. '#' -> '%23'), otherwise auth will silently fail.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- App auth (single shared password gate) ----------------------------------
# The entire app sits behind this one password (single-user tool, no accounts).
APP_PASSWORD="pick-a-strong-password"

# Signs the auth session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="generate-a-64-char-hex-string"

# --- Cron / sync protection --------------------------------------------------
# Bearer token that Vercel Cron (and the "Sync now" button server-side) must send
# to hit the protected /api/sync route. Generate like SESSION_SECRET.
CRON_SECRET="generate-a-random-string"

# --- Base URL ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
